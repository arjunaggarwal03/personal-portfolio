{
  "name": "personal-portfolio",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "content:validate": "node --conditions=react-server --import tsx scripts/content-validate.ts",
    "log:scan": "node scripts/log-scan.mjs",
    "log:publish": "node --env-file-if-exists=.env.local --import tsx scripts/log-publish.mjs",
    "test:unit": "node --conditions=react-server --import tsx --test tests/unit/*.test.*",
    "test:browser": "node scripts/run-with-test-port.mjs playwright test --grep-invert @perf",
    "test:a11y": "node scripts/run-with-test-port.mjs playwright test tests/accessibility.spec.ts",
    "test:perf": "node scripts/run-with-test-port.mjs playwright test tests/performance.spec.ts && node scripts/lighthouse-audit.mjs",
    "test:perf:full": "node scripts/run-with-test-port.mjs playwright test tests/performance.spec.ts && node scripts/lighthouse-audit.mjs --full",
    "analyze": "next experimental-analyze --output",
    "links:external": "node scripts/external-links.mjs",
    "audit:prod": "npm audit --omit=dev",
    "knip": "knip",
    "check:fast": "npm run content:validate && npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "check": "npm run check:fast && npm run audit:prod && npm run build && npm run test:browser && npm run test:perf"
  },
  "dependencies": {
    "@mux/mux-player-react": "^3.13.2",
    "@shikijs/rehype": "^4.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "feed": "^5.2.1",
    "gray-matter": "^4.0.3",
    "next": "^16.3.4",
    "next-mdx-remote-client": "^2.1.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "shiki": "^4.2.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.13",
    "@mux/mux-node": "^15.1.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "chrome-launcher": "^1.2.1",
    "cloudinary": "^2.11.0",
    "exifr": "^7.1.3",
    "knip": "^6.35.1",
    "lighthouse": "^13.4.1",
    "oxlint": "^1.82.0",
    "postcss": "^8.5.28",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
